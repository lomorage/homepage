<!DOCTYPE html>
<html lang="{{ lang }}">
{% include "head.njk" %}
<body>
{% include "header.njk" %}<main id="main">
<section class="hero wrap" aria-labelledby="hero-title"><div class="hero-copy"><div class="eyebrow"><span class="status-dot"></span>{{ t.eyebrow }}</div><h1 id="hero-title">{{ t.headline }}<br><span>{{ t.headlineAccent }}</span></h1><p class="hero-description">{{ t.description }}</p><div class="hero-actions"><a class="button desktop-primary" href="#download">{{ t.download }}<span aria-hidden="true">↗</span></a><a class="button mobile-primary" href="#download">{{ t.mobileDownload }} <span aria-hidden="true">↗</span></a><a class="text-link" href="#how">{{ t.seeHow }} <span aria-hidden="true">→</span></a></div><p class="hero-note"><span aria-hidden="true">✓</span> {{ t.free }} <span class="note-divider">/</span> {{ t.noSubscription }}</p><div class="hero-footnote"><span class="tiny-heart" aria-hidden="true">♡</span><span>{{ t.madeFor }}</span></div></div>
<div class="memory-scene" aria-label="{{ t.sceneLabel }}"><div class="scene-circle" aria-hidden="true"></div><span class="scene-caption">{{ t.littleMoments }} <span aria-hidden="true">↘</span></span><figure class="photo photo-main"><img src="/img/home/family.jpg" alt="{{ t.coastAlt }}" width="760" height="920" fetchpriority="high"><figcaption><span>{{ t.photoCaption }}</span><span class="photo-heart" aria-hidden="true">♡</span></figcaption></figure><figure class="photo photo-small"><img src="/img/home/coast.jpg" alt="{{ t.familyAlt }}" width="520" height="600"><figcaption>{{ t.smallCaption }} <span aria-hidden="true">☀</span></figcaption></figure><div class="backup-badge"><span class="backup-check" aria-hidden="true">✓</span><div><strong>{{ t.safeTitle }}</strong><span>{{ t.safeText }}</span></div><span class="badge-spark" aria-hidden="true">✧</span></div><span class="scene-scribble" aria-hidden="true">✳</span></div></section>
<div class="trust-strip"><div class="wrap trust-inner"><span>{{ t.trustLead }}</span><span><b aria-hidden="true">⌂</b>{{ t.trustLocal }}</span><span><b aria-hidden="true">◉</b>{{ t.trustOriginal }}</span><span><b aria-hidden="true">♡</b>{{ t.trustFamily }}</span><span><b aria-hidden="true">∞</b>{{ t.trustFree }}</span></div></div>
<section class="product-section wrap" aria-labelledby="product-title"><figure class="app-preview"><div class="phone-shell"><img src="{{ t.screenshot }}" alt="{{ t.screenshotAlt }}" width="1125" height="2436" loading="lazy"></div><figcaption>{{ t.screenshotCaption }}</figcaption></figure><div class="product-copy"><p class="eyebrow">{{ t.productEyebrow }}</p><h2 id="product-title">{{ t.productTitle }}</h2><p>{{ t.productText }}</p><ol class="product-points">{% for point in t.productPoints %}<li><span aria-hidden="true">0{{ loop.index }}</span><div><h3>{{ point.title }}</h3><p>{{ point.text }}</p></div></li>{% endfor %}</ol><a class="text-link" href="{{ t.productLinkUrl }}">{{ t.productLink }} <span aria-hidden="true">→</span></a></div></section>
<section id="why" class="section wrap"><div class="section-heading"><div><p class="eyebrow">{{ t.whyEyebrow }}</p><h2>{{ t.whyTitle }}</h2></div><p>{{ t.whyDescription }}</p></div><div class="benefit-grid">{% for item in t.benefits %}<article class="benefit"><span class="feature-symbol symbol-{{ loop.index0 }}" aria-hidden="true">{{ item.symbol }}</span><h3>{{ item.title }}</h3><p>{{ item.text }}</p><span class="feature-tag">{{ item.tag }}</span></article>{% endfor %}</div></section>
<section class="readiness wrap"><h2>{{ t.readyTitle }}</h2><ul>{% for item in t.readyItems %}<li><span aria-hidden="true">✓</span>{{ item }}</li>{% endfor %}</ul><p>{{ t.readyNote }}</p></section>
<section id="how" class="how-section"><div class="wrap how-grid"><div class="how-visual"><div class="connection-card"><span class="eyebrow">{{ t.yourHome }}</span><div class="device-row"><div><svg viewBox="0 0 60 80" aria-hidden="true"><rect x="11" y="3" width="38" height="71" rx="8"/><path d="M24 9h12M27 67h6"/></svg><span>{{ t.phone }}</span></div><div class="connection-line"><span>· · · · ·</span><b>✓</b><small>Wi-Fi</small></div><div><svg viewBox="0 0 90 80" aria-hidden="true"><rect x="10" y="7" width="70" height="48" rx="5"/><path d="M45 55v14M29 70h32"/><path class="device-heart" d="M45 27c-12-12-22 5 0 17 22-12 12-29 0-17Z"/></svg><span>{{ t.computer }}</span></div></div><div class="connection-bottom"><span class="status-dot"></span>{{ t.connectionNote }}</div></div><p class="handwritten">{{ t.homeNote }} <span aria-hidden="true">♡</span></p></div><div class="how-copy"><p class="eyebrow">{{ t.howEyebrow }}</p><h2>{{ t.howTitle }}</h2><ol class="steps">{% for item in t.steps %}<li><span class="step-number">0{{ loop.index }}</span><div><h3>{{ item.title }}</h3><p>{{ item.text }}</p></div></li>{% endfor %}</ol><a class="text-link" href="{{ t.downloadUrl }}">{{ t.setupGuide }} <span aria-hidden="true">→</span></a></div></div></section>

{% include "downloads.njk" %}
<section id="questions" class="section wrap faq-section"><div><p class="eyebrow">{{ t.faqEyebrow }}</p><h2>{{ t.faqTitle }}</h2><a class="text-link" href="{{ t.faqUrl }}">{{ t.moreQuestions }} <span aria-hidden="true">↗</span></a></div><div class="faq-list">{% for item in t.faqs %}<details><summary>{{ item.question }}<span aria-hidden="true">+</span></summary><p>{{ item.answer }}</p></details>{% endfor %}</div></section>

<section class="closing wrap"><span class="closing-flower" aria-hidden="true">✳</span><p class="eyebrow">{{ t.closingEyebrow }}</p><h2>{{ t.closingTitle }}</h2><p>{{ t.closingText }}</p><a class="button" href="{{ t.downloadUrl }}">{{ t.download }} <span aria-hidden="true">↗</span></a><small>{{ t.closingNote }}</small></section>
</main>{% include "footer.njk" %}<script src="/js/downloads.js" defer></script></body></html>
